# SPECTR Hardware Bridge Environment Configuration Example
# Copy this file to .env and set real credentials for production

MQTT_BROKER=your_hivemq_broker_url.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=your_mqtt_username
MQTT_PASS=your_mqtt_password
MQTT_TOPIC=drone/DRONE_01

AES_SECRET_KEY=16_byte_secret_key!
AES_IV=16_byte_initial_vector!

# Camera source: 0 for local webcam, or HTTP/RTSP URL
CAMERA_URL=http://192.168.137.27:8080/video

# Express server target
EXPRESS_API_URL=http://localhost:5000/api/data
