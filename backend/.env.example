# SPECTR Express Backend Environment Configuration
# Copy this file to .env and fill in real values

MONGO_URI=mongodb://localhost:27017/spectr
PORT=5000
SIMULATE=false

# Email alert credentials (Gmail App Password)
ALERT_RECIPIENTS=your_email@gmail.com, other@gmail.com
ALERT_EMAIL=your_email@gmail.com
ALERT_PASSWORD=your_app_password_here

# Optional: set a secret token to protect the breach-approve endpoint
# If set, callers must send header: x-breach-token: <value>
BREACH_SECRET=change_me_to_a_strong_random_string
